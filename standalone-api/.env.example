# Punjab HMIS Portal URL
PORTAL_URL=https://hmis.punjab.gov.pk

# HMIS Staff Credentials
PORTAL_USERNAME=your_hmis_username
PORTAL_PASSWORD=your_hmis_password

# Target Hospital ID (19 = Lahore General Hospital, 18 = Services Hospital, etc.)
PORTAL_HOSPITAL_ID=19

# Service Port & Browser Configuration
PORT=8080
GATEWAY_PORT=8080
HEADLESS_MODE=true

# Optional Bearer Token Authentication (leave blank to allow all local requests)
API_SECRET_KEY=
